{
  "expo": {
    "name": "OneMoreWeatherApp",
    "slug": "one-more-weather-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.onemoreweather.app",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "CFBundleDisplayName": "Погода"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070d24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.onemoreweather.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Местоположение нужно, чтобы показать погоду там, где вы находитесь.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosReducedAccuracyByDefault": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070d24",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "./plugins/withAppLabel",
        {
          "label": "Погода"
        }
      ]
    ],
    "scheme": "onemoreweather",
    "experiments": {
      "typedRoutes": true
    }
  }
}
